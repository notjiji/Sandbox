# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sandbox
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=changeme

# Application secrets (min 32 characters — never commit real values)
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_SECRET=change-me-to-another-long-random-string-min-32-chars

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (used in later phases)
OPENAI_API_KEY=

# Environment: development | staging | production
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# JWT
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
EMAIL_VERIFICATION_OTP_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_OTP_MAX_ATTEMPTS=5

ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_DURATION_SECONDS=900

# Frontend (used in password reset links)
FRONTEND_URL=http://localhost

# Public API origin used in agent install commands
PUBLIC_API_URL=http://localhost:8000/api/v1
AGENT_ENROLLMENT_TOKEN_EXPIRE_MINUTES=15

# Resend (https://resend.com — get API key from dashboard)
RESEND_API_KEY=
RESEND_FROM=Sandbox <onboarding@resend.dev>

# Audit SIEM export: none | syslog | splunk | elk | sentinel
AUDIT_SIEM_SINK=none
AUDIT_SYSLOG_HOST=
AUDIT_SYSLOG_PORT=514
AUDIT_SYSLOG_PROTOCOL=udp
AUDIT_SPLUNK_HEC_URL=
AUDIT_SPLUNK_HEC_TOKEN=
AUDIT_ELK_URL=
AUDIT_ELK_INDEX=sandbox-audit
AUDIT_ELK_API_KEY=
AUDIT_SENTINEL_WORKSPACE_ID=
AUDIT_SENTINEL_SHARED_KEY=
AUDIT_SENTINEL_LOG_TYPE=SandboxAudit

# Nginx / Monitoring
NGINX_PORT=80
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

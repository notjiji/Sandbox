# Production edge — automatic Let's Encrypt when EDGE_DOMAIN resolves publicly.
# Requires: EDGE_DOMAIN, ACME_EMAIL in the container environment.
#
# Validate: docker run --rm -v "$PWD/infrastructure/edge/Caddyfile:/etc/caddy/Caddyfile:ro" caddy:2-alpine caddy validate --config /etc/caddy/Caddyfile

{
	email {$ACME_EMAIL}
}

{$EDGE_DOMAIN} {
	encode gzip zstd

	@http protocol http
	redir @http https://{host}{uri} permanent

	reverse_proxy nginx:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto https
	}
}

# Sandbox — production deployment (.env)
# Copy: cp .env.production.example .env
#
# Used with docker-compose.prod.yml only.
#
# Boot sequence:
#   1. Edit every CHANGE-ME / example.com value below
#   2. docker compose -f docker-compose.prod.yml run --rm migrate
#   3. docker compose -f docker-compose.prod.yml up -d --build
#
# Architecture:
#   Internet → TLS edge proxy (you provide) → nginx:80 → frontend + /api → backend
#   Postgres, Redis, Celery worker/beat: internal Docker network only (no host ports)

# --- Database (internal service name — do not expose Postgres publicly) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sandbox
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=CHANGE-ME-strong-postgres-password-no-changeme

# --- Application secrets (generate with: openssl rand -hex 32) ---
SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-32-minimum-length-required
JWT_SECRET=CHANGE-ME-use-openssl-rand-hex-32-minimum-length-required

# --- Redis (internal only) ---
REDIS_URL=redis://redis:6379/0

# --- Environment (required for production validator) ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
AI_ENABLED=false

# --- Security (must match your public HTTPS origin) ---
CORS_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# --- JWT / auth ---
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
EMAIL_VERIFICATION_OTP_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_OTP_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_DURATION_SECONDS=900

# --- Public URLs (HTTPS — used in emails and agent install commands) ---
FRONTEND_URL=https://app.example.com
PUBLIC_API_URL=https://app.example.com/api/v1
AGENT_ENROLLMENT_TOKEN_EXPIRE_MINUTES=15

# --- Background jobs (forced false in docker-compose.prod.yml; set explicitly here too) ---
SCAN_RUN_INLINE=false
REPORT_RUN_INLINE=false

# --- Report files: metadata in Postgres, PDF/HTML in durable storage ---
# Self-hosted prod (default): local backend + Compose volume `report_storage`
REPORT_STORAGE_BACKEND=local
REPORT_STORAGE_PATH=/app/storage/reports

# Cloud / commercial: switch to S3-compatible object storage
# REPORT_STORAGE_BACKEND=s3
# REPORT_S3_BUCKET=sandbox-reports-prod
# REPORT_S3_PREFIX=
# REPORT_S3_REGION=eu-west-1
# REPORT_S3_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
# REPORT_S3_ACCESS_KEY_ID=
# REPORT_S3_SECRET_ACCESS_KEY=
# On AWS EC2/EKS you may omit access keys and rely on IAM instance/task roles.

# --- Email (REQUIRED in production — startup fails without RESEND_API_KEY) ---
RESEND_API_KEY=re_CHANGE-ME-your-resend-api-key
RESEND_FROM=Sandbox <notifications@example.com>

# --- OpenAI (required when AI_ENABLED=true) ---
# AI_ENABLED=false  → assessment-only; chat/report summaries use offline templates
# AI_ENABLED=true   → set a live provider key below
# OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

# --- Audit SIEM export: none | syslog | splunk | elk | sentinel ---
AUDIT_SIEM_SINK=none
AUDIT_SYSLOG_HOST=
AUDIT_SYSLOG_PORT=514
AUDIT_SYSLOG_PROTOCOL=udp
AUDIT_SPLUNK_HEC_URL=
AUDIT_SPLUNK_HEC_TOKEN=
AUDIT_ELK_URL=
AUDIT_ELK_INDEX=sandbox-audit
AUDIT_ELK_API_KEY=
AUDIT_SENTINEL_WORKSPACE_ID=
AUDIT_SENTINEL_SHARED_KEY=
AUDIT_SENTINEL_LOG_TYPE=SandboxAudit

# --- Process sizing ---
UVICORN_WORKERS=4
CELERY_CONCURRENCY=4

# --- Compose: only nginx publishes a port (bind to localhost if edge proxy is on same host) ---
NGINX_HTTP_PORT=80
# NGINX_HTTP_PORT=127.0.0.1:8080

# --- Automated backups (backup service in docker-compose.prod.yml) ---
# Generate passphrase: openssl rand -hex 32
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE-ME-use-openssl-rand-hex-32-for-backup-encryption
BACKUP_RETENTION_DAYS=7
BACKUP_REPORT_FILES=true
# Optional offsite copy (requires aws CLI in backup image if used):
# BACKUP_S3_URI=s3://your-bucket/sandbox-backups

# --- TLS edge proxy (not part of this compose file) ---
# Terminate HTTPS at Caddy, Traefik, nginx on the host, or a cloud load balancer.
# Forward plain HTTP to NGINX_HTTP_PORT with X-Forwarded-Proto: https

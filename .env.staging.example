# Sandbox — staging deployment (.env)
# Copy: cp .env.staging.example .env
#
# Pipeline: Local → CI → Staging (this file) → Production
#
# Boot:
#   docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml run --rm migrate
#   docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml up -d --build
#
# Acceptance test (full product story + restart checks):
#   make staging-acceptance

COMPOSE_PROJECT_NAME=sandbox-staging

# --- Database (internal only) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sandbox
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=CHANGE-ME-staging-postgres-password-32chars

# --- Application secrets (generate with: openssl rand -hex 32) ---
SECRET_KEY=CHANGE-ME-staging-secret-key-minimum-32-characters
JWT_SECRET=CHANGE-ME-staging-jwt-secret-minimum-32-characters

# --- Redis (internal only) ---
REDIS_URL=redis://redis:6379/0

# --- Staging mode (production validator skipped; Celery workers required) ---
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO
AI_ENABLED=false
STAGING_FIXED_OTP=123456

# --- Security (match your staging origin) ---
CORS_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# --- Public URLs (HTTP OK in staging) ---
FRONTEND_URL=http://localhost
PUBLIC_API_URL=http://localhost/api/v1
AGENT_ENROLLMENT_TOKEN_EXPIRE_MINUTES=15

# --- Background jobs (forced false in prod compose; explicit here) ---
SCAN_RUN_INLINE=false

# --- Report storage (durable volume — tested by staging acceptance) ---
REPORT_STORAGE_BACKEND=local
REPORT_STORAGE_PATH=/app/storage/reports

# --- Email (Resend optional in staging; OTP uses STAGING_FIXED_OTP) ---
RESEND_API_KEY=
RESEND_FROM=Sandbox Staging <staging@example.com>

# --- OpenAI (optional; AI_ENABLED=false uses offline responses) ---
OPENAI_API_KEY=

# --- Audit SIEM ---
AUDIT_SIEM_SINK=none

# --- Process sizing ---
UVICORN_WORKERS=2
CELERY_CONCURRENCY=2
CELERY_BEAT_PIDFILE=/tmp/celerybeat.pid

# --- Nginx host bind (HTTP entry for staging) ---
NGINX_HTTP_PORT=80

# --- Backups (optional in staging; encryption not required outside production) ---
BACKUP_ENCRYPTION_PASSPHRASE=staging-backup-passphrase-minimum-32-chars
BACKUP_RETENTION_DAYS=7
BACKUP_REPORT_FILES=true

# --- Staging acceptance test overrides (optional) ---
# STAGING_BASE_URL=http://localhost/api/v1
# STAGING_MOCK_TARGET_URL=http://mock-target.test
# STAGING_COMPOSE_PROJECT=sandbox-staging-acceptance
